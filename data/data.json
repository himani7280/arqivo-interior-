      "Motion": {
        "variants": {
          "ArqivoMotion1": {
            "motion": {
              "ease": [
                0.22,
                1,
                0.36,
                1
              ],
              "duration": 1,
              "reveal": {
                "up": {
                  "hidden": {
                    "opacity": 0,
                    "y": 48
                  },
                  "show": {
                    "opacity": 1,
                    "x": 0,
                    "y": 0,
                    "scale": 1
                  }
                },
                "left": {
                  "hidden": {
                    "opacity": 0,
                    "x": -60
                  },
                  "show": {
                    "opacity": 1,
                    "x": 0,
                    "y": 0,
                    "scale": 1
                  }
                },
                "right": {
                  "hidden": {
                    "opacity": 0,
                    "x": 60
                  },
                  "show": {
                    "opacity": 1,
                    "x": 0,
                    "y": 0,
                    "scale": 1
                  }
                },
                "zoom": {
                  "hidden": {
                    "opacity": 0,
                    "scale": 0.9
                  },
                  "show": {
                    "opacity": 1,
                    "x": 0,
                    "y": 0,
                    "scale": 1
                  }
                },
                "fade": {
                  "hidden": {
                    "opacity": 0
                  },
                  "show": {
                    "opacity": 1
                  }
                }
              },
              "stagger": {
                "container": {
                  "hidden": {},
                  "show": {
                    "transition": {
                      "staggerChildren": 0.13
                    }
                  }
                },
                "item": {
                  "hidden": {
                    "opacity": 0,
                    "y": 56
                  },
                  "show": {
                    "opacity": 1,
                    "y": 0
                  }
                }
              },
              "word": {
                "container": {
                  "hidden": {},
                  "show": {
                    "transition": {
                      "staggerChildren": 0.07
                    }
                  }
                },
                "item": {
                  "hidden": {
                    "y": "112%"
                  },
                  "show": {
                    "y": "0%"
                  }
                }
              },
              "clip": {
                "hidden": {
                  "clipPath": "inset(0 0 100% 0)"
                },
                "show": {
                  "clipPath": "inset(0 0 0% 0)"
                }
              },
              "page": {
                "initial": {
                  "opacity": 0,
                  "y": 18
                },
                "animate": {
                  "opacity": 1,
                  "y": 0
                },
                "transition": {
                  "duration": 0.7,
                  "ease": [
                    0.22,
                    1,
                    0.36,
                    1
                  ]
                }
              },
              "preloader": {
                "duration": 2.2,
                "storageKey": "arqivo-intro-seen"
              }
            }
          }
        }
